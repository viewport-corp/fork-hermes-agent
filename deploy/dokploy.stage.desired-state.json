{
  "composeId": "<new-dokploy-stage-compose-id>",
  "sourceType": "git",
  "customGitUrl": "https://github.com/viewport-corp/fork-hermes-agent.git",
  "customGitBranch": "main",
  "composePath": "deploy/dokploy.stage.yml",
  "composeType": "docker-compose",
  "stageOnly": true,
  "image": "docker.io/nousresearch/hermes-agent:v2026.9.24@sha256:fca358f12efd65bfaaca05884166f15c0e2788375ca30d77061ac1ebc96452b7",
  "requiredVariables": [
    "HERMES_STAGE_PROJECT_NAME",
    "HERMES_STAGE_CONTAINER_NAME",
    "HERMES_STAGE_STATE_DIR",
    "HERMES_STAGE_NETWORK_NAME",
    "HERMES_STAGE_SUBNET",
    "HERMES_STAGE_IPV4_ADDRESS",
    "HERMES_STAGE_IMAGE"
  ],
  "secrets": {
    "source": "none",
    "allowedProjectedKeys": [],
    "forbiddenProductionSecretClasses": [
      "TELEGRAM_*",
      "HERMES_DASHBOARD_*",
      "OPENAI_API_KEY",
      "ANTHROPIC_API_KEY",
      "OPENROUTER_API_KEY",
      "GITHUB_TOKEN*"
    ],
    "stageSecretContract": "Stage receives no secrets: no platformx.env mount, no env_file, no Telegram, model, GitHub or dashboard secrets. Internal health validation does not need them."
  },
  "runtimeIsolation": {
    "noProductionStateMount": true,
    "forbiddenProductionStateDir": "/srv/viewport/runtime/hermes-viewport-v2026-8-27",
    "noPublishedPorts": true,
    "noPublicEdgeIp": true,
    "healthcheck": "http://127.0.0.1:9119/api/health",
    "legacyEnvExclusion": {
      "required": true,
      "forbiddenFiles": [
        ".env",
        ".op.env"
      ],
      "reason": "Stage state snapshots must not carry production or legacy Hermes env files (a copied live Telegram token would 409 the live bot); the stage entrypoint guard fails closed with exit 78 if either file exists in /opt/data."
    }
  }
}
